#! /usr/bin/env ruby

=begin
  
  aro

  entry point for the aro cli.

  by i2097i

=end

require :aro.to_s

Aos::Os.configure_aro_cli

if CLI::FLAGS[:VERSION].include?(CLI::ARGV0)
  Aro::P.say(Aro::VERSION)
  exit(CLI::EXIT_CODES[:SUCCESS])
end

if !CLI::ARGV0&.to_s&.upcase.nil? &&
  I18n.t("cards.index").include?(Aro::Teck.card_strip(CLI::ARGV0.to_s.upcase))
  Aro::Teck.print_card(CLI::ARGV0.to_s.upcase)
  exit(CLI::EXIT_CODES[:SUCCESS])
end

case CLI::ARGV0
when CLI::CMDS[:ARO][:COR]
  Aos.cor
when CLI::CMDS[:ARO][:CREATE]
  CLI.create
when CLI::CMDS[:ARO][:TECK]
  CLI.teck
when CLI::CMDS[:ARO][:DOM]
  CLI.dom
when CLI::CMDS[:ARO][:INIT]
  Aro::Mancy.init
else
  unless Aro::Mancy.teck.nil? || CLI::FLAGS[:HELP].include?(CLI::ARGV0)
    Aro::P.say(I18n.t("cli.messages.welcome", name: "#{Aro::Teck.name}"))
    Aro::Mancy.init
    Aro::Mancy.teck.show

    exit(CLI::EXIT_CODES[:SUCCESS])
  end

  CLI.usage_main
  exit(CLI::EXIT_CODES[:SUCCESS])
end
