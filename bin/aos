#! /usr/bin/env ruby

=begin

  aos

  entry point for aos.

  by i2097i

=end

require :aro.to_s

unless Aro::Dom.in_arodom?
  Aos::S.say(I18n.t("cli.errors.not_in_aos" , cmd: Aos::Os.name))
  exit(CLI::EXIT_CODES[:GENERAL_ERROR])
end

if CLI::ARGV0.nil?
  exit(Aos::run)
else #if Aos::Os.is_aos_command?(ARGV[Aro::Mancy::O])
  exit(Aos::process)
end