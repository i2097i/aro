#! /usr/bin/env ruby

=begin

  aos

  entry point for aos.

  by i2097i

=end

require :aro.to_s

unless Aro::Dom.in_arodom?
  Aos::S.say(I18n.t("cli.errors.not_in_aos" , cmd: Aos::Os.name))
  exit(CLI::EXIT_CODES[:GENERAL_ERROR])
end

if CLI::ARGV0.nil? || CLI::ARGV0 == Aos::Os::YOU_FLAG.to_sym
  exit(Aos::run)
else
  exit(Aos::process)
end