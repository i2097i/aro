# helper script for consistency when doing releases

# start on latest develop branch

# 1) update code for release
#     - version
#     - release notes (use "this version" verbiage)
# 2) test and build
#     $ rake make 
# 3) build checksum
#     $ rake build:checksum
# 4) create a commit
# 5) push develop
# 6) pull request develop -> master & merge
# 7) checkout and pull master
# 8) publish to rubygems (warning, must version up after this)
#     $ gem push pkg/aro-x.x.x.gem

